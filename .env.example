# rag-platform env — split-host deployment (VM2 core / nsspq ingest).
# Copy to .env on BOTH hosts; values identical except nothing — same file works.

# -- identity ------------------------------------------------------------
RAG_TAILSCALE_IP=<vm2-store-ip>          # VM2 — where stores/api/mcp publish
TEI_QUERY_PUBLIC_URL=http://<ingest-host-ip>:8082   # nsspq — tei-query for VM2's mcp

# -- control plane -------------------------------------------------------
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=rag
MINIO_ROOT_PASSWORD=change-me-too
QDRANT_API_KEY=change-me-as-well
# Bearer key for the MCP server. Consumed by mcp (tool-call auth) and by web
# (the dashboard's MCP Playground proxy — key stays server-side).
MCP_API_KEY=openssl-rand-hex-32

# -- object storage ------------------------------------------------------
# Tailscale URL so presigned PUTs work from any tailnet host (and the UI).
S3_PUBLIC_ENDPOINT=http://<vm2-store-ip>:9000

# -- admin UI (browser side) --------------------------------------------
NEXT_PUBLIC_API_URL=http://<vm2-store-ip>:8000

# -- admin web console (Phase 2) -----------------------------------------
ADMIN_USER=admin
# bcrypt hash of the admin password:
#   node -e "require('bcryptjs').hashSync(process.argv[1], 10)" 'your-password'
ADMIN_PASSWORD_HASH=
AUTH_JWT_SECRET=openssl-rand-hex-32
# Admin API key the web proxy uses for /v1/* calls (never sent to the
# browser). require_scope is a plain membership check, NOT hierarchical —
# the key must carry EVERY scope the console exercises (admin for key
# management/usage/retry, ingest for upload presign+commit, search for
# collection-scoped reads). Bootstrap the first key once the API is up:
#   uv run python -c "
#     import secrets; from core.db.session import make_session_factory, make_engine
#     from core.db.models import ApiKey; from core.keys import hash_key
#     raw = 'ragk_' + secrets.token_urlsafe(32)
#     s = make_session_factory(make_engine())(); s.add(ApiKey(name='web-admin',
#       key_hash=hash_key(raw), scopes=['admin','ingest','search'])); s.commit(); print(raw)"
API_ADMIN_KEY=
# API_ADMIN_KEY must carry BOTH admin and search scopes — the admin UI's
# mutating proxies need admin, and the documents/collections browser reads
# ride /api/admin/v1/* after the read endpoints were gated with
# require_scope("search") (no superset logic exists in require_scope, so
# the key needs both or every proxied dashboard read 403s):
#   scopes=['admin','search']

# -- rerank (Phase 2) --------------------------------------------------------
# Cross-encoder rerank via TEI /rerank on the ingest host (nsspq :8083).
RERANK_ENABLED=false                          # true enables the rerank stage
TEI_RERANK_PUBLIC_URL=                        # e.g. http://<ingest-host-ip>:8083 (required when RERANK_ENABLED=true)
RERANK_CANDIDATES=30                          # candidate pool fetched from Qdrant (tool top_k unaffected)
RERANK_TIMEOUT_S=5                            # per-request rerank HTTP timeout

# -- embedding plane -----------------------------------------------------
EMBED_MODEL=BAAI/bge-m3
# LOG_LEVEL=info
