# lybrix 2.0 env — split-host deployment (VM2 core / nsspq ingest).
# Copy to .env on BOTH hosts; values identical except nothing — same file works.

# -- identity ------------------------------------------------------------
RAG_TAILSCALE_IP=<vm2-store-ip>          # VM2 — where stores/lybrix-server publish
TEI_QUERY_PUBLIC_URL=http://<ingest-host-ip>:8082   # nsspq — tei-query for VM2's mcp

# -- control plane -------------------------------------------------------
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=rag
MINIO_ROOT_PASSWORD=change-me-too
# Bearer key for the MCP server. Consumed by lybrix-server (tool-call auth)
# and by web (the dashboard's MCP Playground proxy — key stays server-side).
MCP_API_KEY=openssl-rand-hex-32

# -- object storage ------------------------------------------------------
# Tailscale URL so presigned PUTs work from any tailnet host (and the UI).
S3_PUBLIC_ENDPOINT=http://<vm2-store-ip>:9000

# -- admin UI (browser side) --------------------------------------------
NEXT_PUBLIC_API_URL=http://<vm2-store-ip>:8000

# -- admin web console ---------------------------------------------------
ADMIN_USER=admin
# bcrypt hash of the admin password:
#   node -e "require('bcryptjs').hashSync(process.argv[1], 10)" 'your-password'
ADMIN_PASSWORD_HASH=
AUTH_JWT_SECRET=openssl-rand-hex-32
API_ADMIN_KEY=

# -- 2.0 additions -------------------------------------------------------
# docling-serve HTTP fallback base (ingest plane; see docker-compose).
DOCLING_URL=http://docling-serve:5001
# Fast-path toggle: false forces every shard through docling-serve even on
# -tags anydoc builds (useful for A/B parsing quality).
ANYDOC_ENABLED=true

# -- chunking ------------------------------------------------------------
# Sizes are RUNE counts (not tokens). Children are the embedded retrieval
# units; parents carry wider context and are not embedded. Chunk text is a
# verbatim slice of the parsed markdown, so tables and code blocks survive
# into the index; a table larger than a budget splits between rows.
#
# CHUNK_STRATEGY=auto runs the document profiler, which picks heading-aware
# splitting when the doc has a heading backbone, then heuristic markers, and
# falls back to a plain recursive splitter. Force one with
# heading|heuristic|recursive|legacy.
CHUNK_STRATEGY=auto
CHUNK_SIZE=512
CHUNK_OVERLAP=80
PARENT_CHUNK_SIZE=2048
CHILD_CHUNK_SIZE=384

# -- embedding model registry SEED (2.0.1) -------------------------------
# Legacy EMBED_* / TEI_*_URL vars are read ONLY on first boot, when the
# embedding_models table is empty, to create the default registry row.
# Afterwards models are managed in the UI (Models page) — these values are
# inert. first-boot seed only — manage models in the UI afterwards.
#EMBED_BACKEND=tei
#EMBED_MODEL=BAAI/bge-m3
#EMBED_DIM=1024
#TEI_INGEST_URL=http://tei-ingest:80
#TEI_QUERY_URL=http://tei-query:80

# BOOTSTRAP: after `make up-core`, create the first admin key with:
#   docker compose --profile core run --rm lybrix-server /app/lybrix-server keys bootstrap admin
# and put the printed ragk_… value into API_ADMIN_KEY / MCP_API_KEY as needed.

# -- reranker registry SEED (Workstream 1) --------------------------------
# RERANK_ENABLED / RERANK_MODEL / TEI_RERANK_URL are read ONLY on first
# boot, when the rerank_models table is empty AND RERANK_ENABLED=true, to
# create the seed 'tei-rerank' row. Afterwards rerankers are managed in the
# UI (Models page → Rerankers) — these values are inert. RERANK_CANDIDATES
# (candidate pool size, default 30) and RERANK_TIMEOUT_S (default 5) stay
# RUNTIME knobs of the rerank stage.
#RERANK_ENABLED=false
#RERANK_MODEL=bge-reranker-v2-m3
#TEI_RERANK_URL=http://tei-query:8083
#RERANK_CANDIDATES=30
#RERANK_TIMEOUT_S=5
