# deploy/Dockerfile.lybrix — the one 2.0 image: lybrix-server + cmd/lybrix-eval.
#
# Default build compiles the anydoc package with the stub fallback (pure-Go,
# CGO-free). -tags anydoc links the real Rust lib when
# third_party/anydoc-go/lib/linux_amd64_gnu/libanydoc_go.a exists (ingest
# host builds; see third_party/anydoc-go/README.md).
FROM golang:1.23-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY third_party/anydoc-go/include/ third_party/anydoc-go/include/
RUN CGO_ENABLED=0 go build -o /out/lybrix-server ./cmd/lybrix-server \
 && CGO_ENABLED=0 go build -o /out/lybrix-eval ./cmd/lybrix-eval

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/lybrix-server /app/lybrix-server
COPY --from=build /out/lybrix-eval /app/lybrix-eval
ENTRYPOINT ["/app/lybrix-server"]
