        "operationId": "commit_v1_documents__doc_id__commit_post",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Doc Id"
            }
          },
          {
            "name": "authorization",
