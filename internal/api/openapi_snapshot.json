  "components": {
    "schemas": {
      "CollectionCreate": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model",
            "default": "BAAI/bge-m3"
          },
          "vector_dim": {
            "type": "integer",
            "title": "Vector Dim",
            "default": 1024
          }
        },
        "type": "object",
        "required": ["id", "name"],
        "title": "CollectionCreate"
      },
      "CommitRequest": {
        "properties": {
          "collection_id": {
            "type": "string",
            "title": "Collection Id"
          },
          "content_sha256": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Content Sha256"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": ["collection_id", "content_sha256"],
        "title": "CommitRequest"
      },
      "DocState": {
        "type": "string",
        "enum": [
          "uploaded",
          "splitting",
          "parsing",
          "embedding",
          "indexing",
          "ready",
          "failed",
          "partial",
          "archived"
        ],
        "title": "DocState"
